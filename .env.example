NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Mercado Livre: deixe vazio no primeiro teste local.
# Quando houver acesso aprovado ao endpoint de busca, informe o token localmente.
MERCADO_LIVRE_ACCESS_TOKEN=

# Mantém dados simulados disponíveis enquanto a fonte real não estiver habilitada.
ALLOW_DEMO_OFFERS=true
